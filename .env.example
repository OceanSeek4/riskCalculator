# Development server port configuration
# Default port is 1420, change if occupied
VITE_DEV_PORT=1420

# HMR port (usually DEV_PORT + 1)
VITE_HMR_PORT=1421

# Tauri dev host (leave empty for localhost)
TAURI_DEV_HOST=

# ===========================================
# 崩溃防护与调试开关 (Crash Guard & Debug)
# ===========================================

# 调试模式：1=开启详细错误输出和调试组件, 0=关闭
# Debug mode: 1=enable detailed error output and debug components, 0=disable
VITE_DEBUG=0

# 生产 Source Map：1=生成source map便于生产调试, 0=不生成
# Production Source Map: 1=generate source maps for production debugging, 0=disable
VITE_SOURCEMAP=0

# 使用说明 (Usage Instructions):
# 1. 复制此文件为 .env: cp .env.example .env
# 2. 根据需要修改配置值
# 3. 开发调试时设置 VITE_DEBUG=1
# 4. 生产调试时设置 VITE_SOURCEMAP=1 然后 npm run tauri build
# 5. 错误日志在 %APPDATA%/com.riskcalculator.app/logs (Windows) 或 ~/Library/Logs/com.riskcalculator.app (macOS)